<view class="mj-page">

  <!-- ─── Masthead ─── -->
  <view class="mj-masthead">
    <view class="mj-banner-skew">
      <view class="mj-banner-skew__text">STUDY MAG · 学習マガジン</view>
    </view>
    <view class="mj-masthead__rule"/>
    <view class="mj-masthead__row">
      <text class="mj-vol">ME</text>
      <text class="mj-vol-cn">约稿单 · 我的杂志</text>
    </view>
    <view class="mj-tagline">填完这份单子 · 听到的播客会更像写给你的</view>
  </view>

  <!-- ─── 约稿单 ─── -->
  <view class="prof-dossier">

    <!-- 身份 -->
    <view class="mj-eyebrow-row">
      <view class="mj-eyebrow-cn">身份</view>
      <view class="mj-eyebrow">/ IDENTITY</view>
    </view>
    <input
      class="prof-input"
      placeholder="例：产品经理 / 工程师 / 学生 / 投资人"
      placeholder-class="prof-input-placeholder"
      value="{{form.identity}}"
      maxlength="20"
      bindinput="onIdentityInput"
    />

    <!-- 信息密度 -->
    <view class="mj-eyebrow-row">
      <view class="mj-eyebrow-cn">信息密度</view>
      <view class="mj-eyebrow">/ DENSITY</view>
    </view>
    <view class="prof-density">
      <slider
        class="prof-density__slider"
        min="0" max="2" step="1"
        value="{{densityValue}}"
        block-size="22"
        block-color="#D8321F"
        activeColor="#0B0B0B"
        backgroundColor="#5A5448"
        bindchange="onDensityChange"
      />
      <view class="prof-density__labels">
        <text class="prof-density__lab {{densityValue === 0 ? 'prof-density__lab--on' : ''}}">轻 / LIGHT</text>
        <text class="prof-density__lab {{densityValue === 1 ? 'prof-density__lab--on' : ''}}">中 / MED</text>
        <text class="prof-density__lab {{densityValue === 2 ? 'prof-density__lab--on' : ''}}">密 / DENSE</text>
      </view>
    </view>

    <!-- 对谈偏好 -->
    <view class="mj-eyebrow-row">
      <view class="mj-eyebrow-cn">对谈偏好</view>
      <view class="mj-eyebrow">/ TONE · 多选</view>
    </view>
    <view class="prof-stickers">
      <view
        wx:for="{{TONE_OPTIONS}}"
        wx:key="*this"
        class="prof-sticker {{toneMap[item] ? 'prof-sticker--on' : ''}}"
        data-tone="{{item}}"
        bindtap="onToneTap"
      >{{item}}</view>
    </view>

    <!-- 关注领域 -->
    <view class="mj-eyebrow-row">
      <view class="mj-eyebrow-cn">关注领域</view>
      <view class="mj-eyebrow">/ TOPICS · 多选</view>
    </view>
    <view class="prof-stickers">
      <view
        wx:for="{{allTopics}}"
        wx:key="*this"
        class="prof-sticker {{topicMap[item] ? 'prof-sticker--on' : ''}}"
        data-topic="{{item}}"
        bindtap="onTopicTap"
      >#{{item}}</view>
      <view class="prof-sticker prof-sticker--add" bindtap="onAddTopic">＋ 自定义</view>
    </view>

    <!-- 保存 -->
    <view
      class="mj-cta-primary {{!canSave ? 'mj-cta-primary--disabled' : ''}}"
      hover-class="{{canSave ? 'mj-cta-primary-hover' : ''}}"
      bindtap="onSave"
      style="margin-top: 36rpx;"
    >▮ {{saving ? '存档中…' : '存档 / SAVE'}} ▮</view>

  </view>

  <!-- ─── 閲読暦 ─── -->
  <view class="mj-eyebrow-row" style="margin-top: 56rpx;">
    <view class="mj-eyebrow-cn">閲読暦</view>
    <view class="mj-eyebrow">/ ALMANAC · 過去 28 日</view>
    <view class="mj-eyebrow-rule"/>
  </view>

  <view class="prof-stats">
    <view class="prof-stat">
      <text class="prof-stat__num">{{stats.thisWeekMin || 0}}</text>
      <view class="prof-stat__lab">分 · 本周</view>
    </view>
    <view class="prof-stat prof-stat--mid">
      <text class="prof-stat__num">{{stats.thisMonthMin || 0}}</text>
      <view class="prof-stat__lab">分 · 本月</view>
    </view>
    <view class="prof-stat">
      <text class="prof-stat__num">{{stats.totalEpisodes || 0}}</text>
      <view class="prof-stat__lab">期 · 累计</view>
    </view>
  </view>

  <view class="prof-cal">
    <view class="prof-cal__hdr">
      <view class="prof-cal__hdr-cell">日</view>
      <view class="prof-cal__hdr-cell">一</view>
      <view class="prof-cal__hdr-cell">二</view>
      <view class="prof-cal__hdr-cell">三</view>
      <view class="prof-cal__hdr-cell">四</view>
      <view class="prof-cal__hdr-cell">五</view>
      <view class="prof-cal__hdr-cell">六</view>
    </view>
    <view class="prof-cal__grid">
      <view
        wx:for="{{stats.calendar}}"
        wx:key="date"
        class="prof-cal__cell prof-cal__cell--l{{item.level}}"
        data-date="{{item.date}}"
        data-minutes="{{item.minutes}}"
        bindtap="onCellTap"
      >
        <text class="prof-cal__day">{{item.day}}</text>
      </view>
    </view>
    <view class="prof-cal__legend">
      <text>少</text>
      <view class="prof-cal__sw prof-cal__cell--l0"/>
      <view class="prof-cal__sw prof-cal__cell--l1"/>
      <view class="prof-cal__sw prof-cal__cell--l2"/>
      <view class="prof-cal__sw prof-cal__cell--l3"/>
      <text>多</text>
    </view>
  </view>

  <!-- FIN -->
  <view class="mj-fin-divider">
    <view class="mj-fin-divider__rule"/>
    <view class="mj-sticker mj-sticker--rotate-neg">FIN. / 完</view>
    <view class="mj-fin-divider__rule"/>
  </view>
  <view class="mj-disclaimer">BY AI · 仅供学习参考 · FOR STUDY ONLY</view>
</view>
