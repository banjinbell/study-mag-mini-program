/* ────────────────────────────────────────────────
   Submit page · 仅页面级补丁
   ──────────────────────────────────────────────── */

/* 整页固定不滚 — submit 内容能塞进一屏 */
page {
  height: 100vh;
  overflow: hidden;
}
.mj-page {
  height: 100vh;
  overflow: hidden;
}

.submit-hero {
  margin-top: 40rpx;
  min-height: 200rpx;
}

/* ─── Success sheet (投稿完了) ─── */
.mj-success-sheet {
  position: fixed;
  inset: 0;
  z-index: 2000;
  background: rgba(11, 11, 11, 0.55);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  animation: mj-sheet-fade 0.18s ease-out;
}
@keyframes mj-sheet-fade {
  from { opacity: 0; }
  to { opacity: 1; }
}

.mj-success-sheet__plate {
  width: 100%;
  max-width: 640rpx;
  background-color: var(--mj-newsprint);
  background-image: var(--mj-screentone);
  background-repeat: repeat;
  background-size: 16rpx 16rpx;
  border: 5rpx solid var(--mj-ink);
  box-shadow: var(--mj-shadow-red);   /* hero 红阴影 */
  padding: 36rpx 32rpx 32rpx;
  position: relative;
  animation: mj-sheet-pop 0.22s cubic-bezier(0.18, 0.89, 0.32, 1.18);
}
@keyframes mj-sheet-pop {
  from { transform: translateY(40rpx) scale(0.96); opacity: 0; }
  to { transform: translateY(0) scale(1); opacity: 1; }
}

.mj-success-sheet__sticker {
  position: absolute;
  top: -22rpx;
  right: -8rpx;
  z-index: 2;
}

.mj-success-sheet__title {
  margin-top: 8rpx;
  min-height: 120rpx;
}

.mj-success-sheet__meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 28rpx;
  flex-wrap: wrap;
}

.mj-success-sheet__bar {
  animation: mj-bar-pulse 1.8s ease-in-out infinite;
}
@keyframes mj-bar-pulse {
  0%, 100% { background: rgba(11, 11, 11, 0.18); }
  50% { background: var(--mj-ink); }
}

.mj-success-sheet__cta-row {
  margin-top: 36rpx;
}
