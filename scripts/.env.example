# 学伴项目 - 模型 API 配置示例
# 复制为 .env 后填入真实 Key（.env 已加入 .gitignore，不会上传）

# ========== Provider 默认选择（环境变量切换）==========
VISION_PROVIDER=qwen3-vl-plus
TEXT_PROVIDER=deepseek-v4-flash
REASONING_TEXT_PROVIDER=deepseek-v4-pro
TTS_PROVIDER=doubao-podcast
FAST_TEXT_MODEL=deepseek-v4-flash
VISION_MODEL_FAST=qwen3-vl-plus

# ========== 阿里 DashScope / 百炼 ==========
# 申请：https://bailian.console.aliyun.com → API-KEY 管理
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ========== DeepSeek ==========
# 申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxx

# ========== 火山方舟 Ark（文本/视觉）==========
# 申请：https://console.volcengine.com/ark → API Key 管理
ARK_API_KEY=ark-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx-xxxxx
ARK_TEXT_MODEL=doubao-seed-1-6-251015
ARK_VISION_MODEL=doubao-seed-1-6-vision-251015

# ========== 火山语音技术（TTS 播客）==========
# 申请：https://console.volcengine.com/speech → 应用管理 → 开通"语音播客大模型"
# ⚠️ 新版鉴权是四 header，不再是旧的 APPID+TOKEN
VOLC_TTS_APP_KEY=
VOLC_TTS_ACCESS_KEY=
VOLC_PODCAST_RESOURCE_ID=volc.service_type.10050
VOLC_PODCAST_SPEAKER_A=zh_female_mizaitongxue_v2_saturn_bigtts
VOLC_PODCAST_SPEAKER_B=zh_male_dayixiansheng_v2_saturn_bigtts

# ========== 腾讯混元（文本/视觉）==========
# 申请：https://console.cloud.tencent.com/hunyuan/api-key
HUNYUAN_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== 腾讯云（TTS 播客）==========
# 申请：https://console.cloud.tencent.com/cam/capi
TENCENT_APP_ID=
TENCENT_SECRET_ID=
TENCENT_SECRET_KEY=
TENCENT_PODCAST_SPEAKER_A=101001
TENCENT_PODCAST_SPEAKER_B=101002

# ========== MiniMax ==========
# 申请：https://platform.minimaxi.com → 接口密钥
# ⚠️ 鉴权需要 API Key + GroupId 两个值
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=
MINIMAX_BASE_URL=https://api.minimaxi.chat
MINIMAX_TTS_MODEL=speech-2.6-hd
MINIMAX_VOICE_A=male-qn-qingse
MINIMAX_VOICE_B=Chinese (Mandarin)_Warm_Girl

# ========== 智谱 BigModel ==========
# 申请：https://open.bigmodel.cn → API Keys
ZHIPU_API_KEY=

# ========== Moonshot Kimi ==========
# 申请：https://platform.moonshot.cn → API Key 管理
MOONSHOT_API_KEY=

# ========== SiliconFlow（开源 TTS 托管，可选）==========
# 申请：https://cloud.siliconflow.cn → API 密钥
SILICONFLOW_API_KEY=

# ========== ElevenLabs（海外对照，可选）==========
# 申请：https://elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=
EL_VOICE_A=pNInz6obpgDQGcFmaJgB
EL_VOICE_B=EXAVITQu4vr4xnSDxMaL

# ========== 订阅消息模板 ID（CloudBase 控制台）==========
TMPL_ID=
